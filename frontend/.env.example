# Backend mà nginx của frontend chuyển /api tới. Đổi xong chạy: docker compose up -d
#   Backend chạy bằng Docker (cùng máy):   BACKEND_URL=http://backend:8000
#   Backend chạy `python main.py` (máy này): BACKEND_URL=http://127.0.0.1:8001
#   Backend ở máy khác / server:            BACKEND_URL=http://<ip-backend>:8000
# 127.0.0.1/localhost được tự đổi sang máy host, thiếu http:// hay thừa / ở cuối cũng được.
# Xem kết quả: docker logs todo_frontend
BACKEND_URL=http://backend:8000
