# URL API mà frontend gọi (nhúng vào bundle lúc build, đổi xong phải --build lại).
# /api: đi qua nginx của frontend -> backend (mặc định, nên dùng).
# Gọi thẳng backend: đặt URL đầy đủ, ví dụ http://<ip-ec2>:8000/api
VITE_API_URL=/api

# Chỉ dùng khi dev (npm run dev): backend mà Vite proxy /api tới.
API_TARGET=http://127.0.0.1:8001
