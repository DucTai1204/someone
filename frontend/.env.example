# Backend mà nginx của frontend chuyển /api tới (đổi xong chỉ cần `docker compose up -d`).
# Backend chạy cùng máy bằng Docker: http://backend:8000
# Backend ở máy khác: http://<ip-backend>:8000
BACKEND_URL=http://backend:8000

# URL API mà trình duyệt gọi (nhúng vào bundle lúc build). Để /api để đi qua nginx ở trên.
VITE_API_URL=/api

# Chỉ dùng khi dev (npm run dev): backend mà Vite proxy /api tới.
API_TARGET=http://127.0.0.1:8001
