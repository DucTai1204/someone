# ===== Chọn database =====
# Đang dùng LOCAL. Muốn chuyển sang RDS: thêm # vào block LOCAL, bỏ # ở block RDS.
# Sau khi đổi: docker compose up -d --build --remove-orphans

# ----- LOCAL: MySQL container (service db) -----
COMPOSE_PROFILES=local
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT_HOST=
# Backend trong Docker gọi container db:3306
DB_HOST_DOCKER=db
DB_PORT_DOCKER=3306
# Backend chạy `python main.py` ngoài Docker gọi qua cổng map ra máy
DB_HOST=127.0.0.1
DB_PORT=${DB_PORT_HOST}

# ----- RDS: AWS (container db không chạy) -----
# COMPOSE_PROFILES=
# DB_HOST=db.cnwk62euyuch.ap-southeast-1.rds.amazonaws.com
# DB_PORT=3306
# DB_NAME=todo_db
# DB_USER=admin
# DB_PASSWORD=

# ===== Backend =====
# Mật khẩu root của MySQL container (chỉ dùng ở chế độ LOCAL)
MYSQL_ROOT_PASSWORD=
PORT=8001

# ===== Frontend =====
# URL gốc của API mà frontend gọi tới (được nhúng vào bundle lúc build).
# Để "/api" thì request đi qua proxy (Vite khi dev, nginx khi chạy Docker).
# Muốn gọi thẳng backend thì đặt URL đầy đủ, ví dụ: http://127.0.0.1:8001/api
VITE_API_URL=/api
# Chỉ dùng khi dev: backend mà Vite proxy /api tới.
API_TARGET=http://127.0.0.1:${PORT}
